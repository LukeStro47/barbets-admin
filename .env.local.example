# Same Supabase project as the main Barbets app (app.mybarbets.com) — this site
# reads/writes through admin-gated SECURITY DEFINER Postgres functions, so it
# needs no service-role key for anything implemented so far.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Carried for parity with the main repo's lib/supabase/admin.ts pattern.
# Not used by any code path in this repo yet — every RPC here is already
# admin-gated and callable through the ordinary per-request client.
SUPABASE_SERVICE_ROLE_KEY=
