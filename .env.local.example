# Same Supabase project as the main Barbets app (app.mybarbets.com) — this site
# reads/writes through admin-gated SECURITY DEFINER Postgres functions, so it
# needs no service-role key for anything implemented so far.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Carried for parity with the main repo's lib/supabase/admin.ts pattern.
# Not used by any code path in this repo yet — every RPC here is already
# admin-gated and callable through the ordinary per-request client.
SUPABASE_SERVICE_ROLE_KEY=

# Same Cloudflare Turnstile widget the main app uses. Required: Supabase's
# CAPTCHA protection (Authentication > Attack Protection) is all-or-nothing
# across the whole project, so sign-in here is gated by it too. If Cloudflare
# has this site key domain-restricted, add admin.mybarbets.com (and
# localhost, for local dev) to that widget's allowed domains.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
